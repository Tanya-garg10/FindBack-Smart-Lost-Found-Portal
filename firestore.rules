rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'taniyagarg1007@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'role', 'department', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.role in ['student', 'admin'] &&
        (!('department' in data) || (data.department is string && data.department.size() <= 100)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidItem(data) {
      return data.keys().hasAll([
          'reportCode', 'title', 'description', 'category', 'type',
          'date', 'location', 'image', 'status', 'userId', 'reporterName', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'reportCode', 'title', 'description', 'additionalDetails', 'category', 'type',
          'date', 'location', 'image', 'status', 'userId', 'reporterName', 'createdAt', 'updatedAt', 'isPublic'
        ]) &&
        data.reportCode is string && data.reportCode.size() >= 3 && data.reportCode.size() <= 32 && data.reportCode.matches('^[A-Z0-9\\-]+$') &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 2000 &&
        (!('additionalDetails' in data) || (data.additionalDetails is string && data.additionalDetails.size() <= 1000)) &&
        data.category in ['Electronics', 'ID Cards', 'Bags', 'Stationery', 'Clothing', 'Accessories', 'Other'] &&
        data.type in ['lost', 'found'] &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 40 &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 160 &&
        data.image is string && data.image.size() <= 600000 &&
        data.status in ['Reported', 'Possible Match', 'Verification Pending', 'Verified', 'Returned', 'Flagged'] &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 100 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('isPublic' in data) || data.isPublic is bool);
    }

    function isValidMatch(data) {
      return data.keys().hasAll([
          'lostItemId', 'foundItemId', 'lostItemTitle', 'foundItemTitle',
          'matchScore', 'categoryMatch', 'descriptionSimilarity', 'locationMatch',
          'dateMatch', 'reasonsSummary', 'status', 'createdBy', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'lostItemId', 'foundItemId', 'lostItemTitle', 'foundItemTitle',
          'matchScore', 'categoryMatch', 'descriptionSimilarity', 'locationMatch',
          'dateMatch', 'reasonsSummary', 'status', 'createdBy', 'createdAt', 'isPublic'
        ]) &&
        data.lostItemId is string && data.lostItemId.size() >= 1 && data.lostItemId.size() <= 128 &&
        data.foundItemId is string && data.foundItemId.size() >= 1 && data.foundItemId.size() <= 128 &&
        data.lostItemTitle is string && data.lostItemTitle.size() >= 1 && data.lostItemTitle.size() <= 140 &&
        data.foundItemTitle is string && data.foundItemTitle.size() >= 1 && data.foundItemTitle.size() <= 140 &&
        data.matchScore is number && data.matchScore >= 0 && data.matchScore <= 100 &&
        data.categoryMatch is bool &&
        data.descriptionSimilarity is bool &&
        data.locationMatch is bool &&
        data.dateMatch is bool &&
        data.reasonsSummary is string && data.reasonsSummary.size() <= 500 &&
        data.status in ['Active', 'Claimed', 'Verified', 'Dismissed'] &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('isPublic' in data) || data.isPublic is bool);
    }

    function isValidClaim(data) {
      return data.keys().hasAll([
          'itemId', 'itemTitle', 'claimantId', 'claimantName',
          'uniqueFeature', 'attachedContents', 'exactLastSeen', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'itemId', 'matchedLostItemId', 'itemTitle', 'claimantId', 'claimantName',
          'uniqueFeature', 'attachedContents', 'exactLastSeen', 'proofImage',
          'status', 'adminNotes', 'createdAt'
        ]) &&
        data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 128 &&
        (!('matchedLostItemId' in data) || (data.matchedLostItemId is string && data.matchedLostItemId.size() <= 128)) &&
        data.itemTitle is string && data.itemTitle.size() >= 1 && data.itemTitle.size() <= 140 &&
        data.claimantId is string && data.claimantId.size() >= 1 && data.claimantId.size() <= 128 &&
        data.claimantName is string && data.claimantName.size() >= 1 && data.claimantName.size() <= 100 &&
        data.uniqueFeature is string && data.uniqueFeature.size() >= 3 && data.uniqueFeature.size() <= 600 &&
        data.attachedContents is string && data.attachedContents.size() >= 2 && data.attachedContents.size() <= 600 &&
        data.exactLastSeen is string && data.exactLastSeen.size() >= 2 && data.exactLastSeen.size() <= 400 &&
        (!('proofImage' in data) || (data.proofImage is string && data.proofImage.size() <= 600000)) &&
        data.status in ['Verification Pending', 'Approved', 'Rejected'] &&
        (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'message', 'type', 'read', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'message', 'type', 'relatedItemId', 'read', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.message is string && data.message.size() >= 2 && data.message.size() <= 400 &&
        data.type in ['match', 'claim', 'verified', 'returned', 'system'] &&
        (!('relatedItemId' in data) || (data.relatedItemId is string && data.relatedItemId.size() <= 128)) &&
        data.read is bool &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Admins lookup collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // Connection test endpoint
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // Users collection (PII isolated to owner or admin)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && existing().uid is string;
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == request.auth.uid &&
        (incoming().role == 'student' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (isOwner(userId) &&
           incoming().role == existing().role &&
           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'department']))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Items collection (Public campus reports)
    match /items/{itemId} {
      allow get: if isValidId(itemId) && (existing().isPublic == true || isSignedIn());
      allow list: if existing().isPublic == true || isSignedIn();
      allow create: if isSignedIn() && isValidId(itemId) && isValidItem(incoming()) &&
        (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(itemId) && isValidItem(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().status != 'Returned' &&
           existing().userId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'additionalDetails', 'location', 'status', 'updatedAt'])) ||
          (existing().status != 'Returned' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
           incoming().status in ['Possible Match', 'Verification Pending', 'Verified', 'Returned'])
        );
      allow delete: if isAdmin() && isValidId(itemId);
    }

    // Matches collection
    match /matches/{matchId} {
      allow get: if isValidId(matchId) && (existing().isPublic == true || isSignedIn());
      allow list: if existing().isPublic == true || isSignedIn();
      allow create: if isSignedIn() && isValidId(matchId) && isValidMatch(incoming()) &&
        (incoming().createdBy == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(matchId) && isValidMatch(incoming()) &&
        incoming().lostItemId == existing().lostItemId &&
        incoming().foundItemId == existing().foundItemId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
      allow delete: if isAdmin() && isValidId(matchId);
    }

    // Claims collection
    match /claims/{claimId} {
      allow get: if isSignedIn() && isValidId(claimId) && (existing().claimantId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().claimantId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(claimId) && isValidClaim(incoming()) &&
        incoming().claimantId == request.auth.uid &&
        incoming().status == 'Verification Pending';
      allow update: if isSignedIn() && isValidId(claimId) && isValidClaim(incoming()) &&
        incoming().claimantId == existing().claimantId &&
        incoming().itemId == existing().itemId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().claimantId == request.auth.uid &&
           existing().status == 'Verification Pending' &&
           incoming().status == 'Verification Pending' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['uniqueFeature', 'attachedContents', 'exactLastSeen', 'proofImage']))
        );
      allow delete: if isAdmin() && isValidId(claimId);
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
           incoming().diff(existing()).affectedKeys().hasOnly(['read']))
        );
      allow delete: if isSignedIn() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
